# --- Privacidad: datos financieros reales de la familia. NUNCA versionar. ---
data/processed/
data/raw/
*.db
*.sqlite
*.sqlite3
*.db-journal
exports/
*.csv
*.xlsx
*.xls
*.parquet
*.pbix
*.pdf

# Únicas excepciones: lo sintético que genera scripts/estado_sintetico.py, y
# tests/test_privacy.py exige que cada archivo sea, byte a byte, lo que sale del
# script: los estados de cuenta (CSV o PDF, solo en esta carpeta) y las etiquetas
# de verdad de la conciliación (ids y números de línea, sin montos).
!tests/fixtures/estados/*.csv
!tests/fixtures/estados/*.pdf
!evals/pares_verdaderos.csv

# Secretos (token del bot, API keys del LLM)
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# OS / editores
.DS_Store
.vscode/
.idea/

# n8n: estado local de la instancia (base de datos con gastos reales) y credenciales
n8n/.datos/
n8n/e2e/.datos/
n8n/credenciales.json
